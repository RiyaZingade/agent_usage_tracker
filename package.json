{
  "name": "claude-usage-tracker",
  "displayName": "claude-usage-tracker",
  "description": "fun way to track claude agent usage",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeUsageTracker",
          "title": "Claude Usage",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeUsageTracker": [
        {
          "type": "webview",
          "id": "claudeUsageTracker.sidebar",
          "name": "Usage"
        }
      ]
    },
    "configuration": {
      "title": "Claude Usage Tracker",
      "properties": {
        "claude-usage-tracker.dailyBudget": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Your daily message + tool-call budget. The progress bar and icon mood are based on this number."
        }
      }
    },
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
